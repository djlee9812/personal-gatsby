{
  "name": "dongjoon-personal-website",
  "version": "1.0.0",
  "private": true,
  "description": "dongjoon-personal-website",
  "author": "Dongjoon Lee",
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "develop": "gatsby develop",
    "start": "gatsby develop",
    "build": "gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-strip-types --test src/utils/*.test.ts src/lib/*.test.ts",
    "test:e2e": "playwright test",
    "test:links": "linkinator ./public --config ./linkinator.config.json",
    "flights:build": "node scripts/flighty-export-to-json.mjs && node scripts/generate-airport-coordinates.mjs"
  },
  "dependencies": {
    "@fontsource/inconsolata": "^4.5.9",
    "@fontsource/josefin-sans": "^4.5.11",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@mdx-js/mdx": "^2.0.0",
    "@mdx-js/react": "^2.0.0",
    "@qwik.dev/partytown": "^0.11.2",
    "@react-three/fiber": "^8.18.0",
    "d3-geo": "^3.1.1",
    "focus-trap-react": "^10.0.0",
    "framer-motion": "^12.34.2",
    "gatsby": "^5.13.6",
    "gatsby-plugin-image": "^3.0.0",
    "gatsby-plugin-mdx": "^5.0.0",
    "gatsby-plugin-robots-txt": "^1.8.0",
    "gatsby-plugin-sharp": "^5.0.0",
    "gatsby-plugin-sitemap": "^6.0.0",
    "gatsby-source-cloudinary": "^0.6.1",
    "gatsby-source-filesystem": "^5.0.0",
    "gatsby-transformer-cloudinary": "^4.7.0",
    "gatsby-transformer-sharp": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-simple-maps": "^3.0.0",
    "rehype-unwrap-images": "^1.0.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-simple-maps": "^3.0.6",
    "@types/three": "^0.185.1",
    "linkinator": "^8.0.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "minimatch": "^3.1.2",
    "cookie": "^0.7.2",
    "webpack": "^5.94.0",
    "cross-spawn": "^7.0.5",
    "follow-redirects": "^1.15.6",
    "ip": "^2.0.1",
    "debug": "^4.3.5",
    "tmp": "^0.2.3",
    "cloudinary": "^2.10.0",
    "@babel/plugin-proposal-optional-chaining": "npm:@babel/plugin-transform-optional-chaining@^7.28.0",
    "@babel/plugin-proposal-nullish-coalescing-operator": "npm:@babel/plugin-transform-nullish-coalescing-operator@^7.28.0",
    "@babel/plugin-proposal-numeric-separator": "npm:@babel/plugin-transform-numeric-separator@^7.28.0",
    "@babel/plugin-proposal-class-properties": "npm:@babel/plugin-transform-class-properties@^7.28.0",
    "@babel/plugin-proposal-object-rest-spread": "npm:@babel/plugin-transform-object-rest-spread@^7.28.0"
  }
