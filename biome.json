{
	"$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
	"files": {
		"includes": [
			"src/**",
			"e2e/**",
			"scripts/**",
			"gatsby-*.ts",
			"gatsby-*.tsx",
			"gatsby-*.js",
			"playwright.config.ts"
		],
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noNonNullAssertion": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noArrayIndexKey": "off",
				"noShorthandPropertyOverrides": "off"
			},
			"a11y": {
				"useButtonType": "off",
				"noSvgWithoutTitle": "off",
				"useSemanticElements": "off",
				"noStaticElementInteractions": "off"
			},
			"correctness": {
				"useExhaustiveDependencies": "warn",
				"noChildrenProp": "off"
			},
			"nursery": {},
			"security": {
				"noDangerouslySetInnerHtml": "off"
			}
		}
	},
	"assist": {
		"enabled": false
	}
}
